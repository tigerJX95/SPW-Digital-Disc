{
  "configs": [
    {
      "title": "SPW Digital Disc",
      "config": "config.json",
      "preferences": [
        {
          "type": "seekbar",
          "key": "disc_exposure",
          "title": "出碟量",
          "summary": "0：仅封面；50：默认位置；100：完全移出。前置开启时控制移出距离，返回展示页生效。",
          "min": 0,
          "max": 100,
          "default_value": 50
        },
        {
          "type": "switch",
          "key": "disc_in_front",
          "title": "碟片前置展示",
          "summary": "开启后碟片显示在封面前方。出碟量仍控制向右移出距离；0 时仅显示封面。默认关闭。",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "disc_rotation",
          "title": "播放时旋转碟片",
          "summary": "默认关闭。暂停或收起展示页时停在当前角度，恢复后继续。",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "disc_vinyl",
          "title": "默认盘面使用黑胶唱片",
          "summary": "仅在没有可用的自定义盘面时生效。关闭时使用专辑封面 CD。",
          "default_value": false
        },
        {
          "type": "list",
          "key": "disc_motion_speed",
          "title": "出收碟速度",
          "summary": "控制封面过渡及碟片滑出、收回的速度。",
          "entries": [
            "慢速",
            "标准",
            "快速"
          ],
          "entry_values": [
            "SLOW",
            "STANDARD",
            "FAST"
          ],
          "default_value": "STANDARD"
        },
        {
          "type": "list",
          "key": "disc_rotation_speed",
          "title": "碟片旋转速度",
          "summary": "仅在开启播放时旋转碟片后生效。慢速 30 秒、标准 20 秒、快速 12 秒一圈。",
          "entries": [
            "慢速",
            "标准",
            "快速"
          ],
          "entry_values": [
            "SLOW",
            "STANDARD",
            "FAST"
          ],
          "default_value": "STANDARD"
        }
      ]
    }
  ]
}
